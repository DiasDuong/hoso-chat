# ========================================================
# HRBOT / HOSO-CHAT ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace with your actual values:
#   cp .env.example .env
# ========================================================

# PostgreSQL Configuration
PG_USER=hr_admin
PG_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=hrbot

# n8n Automation Engine
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_32_characters_here

# JWT Authentication for Auth Service
JWT_SECRET=your_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=24h

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
