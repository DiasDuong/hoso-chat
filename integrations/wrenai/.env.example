# Generate a unique random token; match it in the protected Hub config.
WREN_SERVICE_TOKEN=REPLACE_WITH_A_UNIQUE_RANDOM_TOKEN_AT_LEAST_32_CHARS
WREN_BI_EXECUTION_ENABLED=true
WREN_PG_HOST=postgres
WREN_PG_PORT=5432
WREN_PG_DATABASE=hrbot
WREN_PG_USER=bi_readonly
# Base64 is transport encoding, not encryption. Protect this file's ACL.
WREN_PG_PASSWORD_BASE64=
